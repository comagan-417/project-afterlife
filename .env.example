# Firebase Emulator Configuration
VITE_USE_EMULATORS=true

# Firebase Project Config (get from Firebase Console after creating a project)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI Provider: mock | gemini | openai | anthropic
# Use 'mock' for local development without an API key
VITE_AI_PROVIDER=mock

# When you get an API key, set the provider above and add the key here
# GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
